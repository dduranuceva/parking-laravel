{
    "openapi": "3.0.0",
    "info": {
        "title": "API de Parqueadero",
        "description": "Documentación de la API de Parqueadero",
        "version": "1.0.0"
    },
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Iniciar sesión",
                "description": "Inicia sesión y retorna el token JWT junto con los datos del usuario.",
                "operationId": "f5914c86f5792eda2324f88d2b4abec7",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "admin@alpha.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "12345678"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login exitoso con token JWT"
                    },
                    "401": {
                        "description": "Credenciales inválidas"
                    },
                    "500": {
                        "description": "Error interno"
                    }
                }
            }
        },
        "/api/perfil": {
            "get": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Perfil del usuario autenticado",
                "description": "Retorna la información del usuario autenticado mediante JWT.",
                "operationId": "1732e6fdb406bd97d56d0850388b309c",
                "responses": {
                    "200": {
                        "description": "Datos del usuario autenticado"
                    },
                    "500": {
                        "description": "Error interno"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Cerrar sesión",
                "description": "Cierra la sesión eliminando el token JWT actual.",
                "operationId": "0fcd11391ee41759f6eeca6123daa135",
                "responses": {
                    "200": {
                        "description": "Sesión cerrada correctamente"
                    },
                    "500": {
                        "description": "Error interno"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/users": {
            "get": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Listar usuarios",
                "description": "Retorna todos los usuarios del sistema.",
                "operationId": "566aed8efb436ca506e0ef51a032ecd9",
                "responses": {
                    "200": {
                        "description": "Lista de usuarios."
                    }
                }
            },
            "post": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Crear usuario",
                "description": "Crea un nuevo usuario en el sistema.",
                "operationId": "be551c1d694a01c164966f58bfa77013",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario creado correctamente."
                    },
                    "422": {
                        "description": "Error de validación."
                    }
                }
            }
        },
        "/api/users/{id}": {
            "get": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Mostrar usuario",
                "operationId": "6f51bd5fa2dddcd25e44cfa53dcbd10a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Usuario encontrado."
                    },
                    "404": {
                        "description": "Usuario no encontrado."
                    }
                }
            },
            "put": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Actualizar usuario",
                "operationId": "070e37fc9aff78ae73860751bc990ed3",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Usuario actualizado."
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Eliminar usuario",
                "operationId": "0b4133ed462528a5e648b88ead11e929",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Usuario eliminado correctamente."
                    },
                    "404": {
                        "description": "Usuario no encontrado"
                    }
                }
            }
        },
        "/api/establecimientos": {
            "get": {
                "tags": [
                    "Establecimientos"
                ],
                "summary": "Mostrar establecimientos",
                "description": "Retorna todos los establecimientos activos",
                "operationId": "a6b8b96ae573d6d24f8043b292b67c91",
                "responses": {
                    "200": {
                        "description": "Listado de establecimientos."
                    },
                    "default": {
                        "description": "Ha ocurrido un error."
                    }
                }
            },
            "post": {
                "tags": [
                    "Establecimientos"
                ],
                "summary": "Crear un establecimiento",
                "description": "Crea un nuevo establecimiento y asigna estado = 'A' por defecto.",
                "operationId": "14f5b014881b4e9a1730257d312811a1",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "nombre",
                                    "nit",
                                    "direccion",
                                    "telefono"
                                ],
                                "properties": {
                                    "nombre": {
                                        "description": "Establecimiento Uno",
                                        "type": "string"
                                    },
                                    "nit": {
                                        "description": "123456789",
                                        "type": "string"
                                    },
                                    "direccion": {
                                        "description": "Calle Falsa 123",
                                        "type": "string"
                                    },
                                    "telefono": {
                                        "description": "555-1234",
                                        "type": "string"
                                    },
                                    "logo": {
                                        "description": "Archivo del logo",
                                        "type": "Base64",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Establecimiento creado correctamente."
                    },
                    "default": {
                        "description": "Ha ocurrido un error."
                    }
                }
            }
        },
        "/api/establecimientos/{id}": {
            "get": {
                "tags": [
                    "Establecimientos"
                ],
                "summary": "Mostrar un establecimiento",
                "description": "Retorna un establecimiento específico por su ID",
                "operationId": "4970a1bd8b63a9fe60ecb878d574257c",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del establecimiento",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detalle del establecimiento."
                    },
                    "default": {
                        "description": "Ha ocurrido un error."
                    }
                }
            },
            "post": {
                "tags": [
                    "Establecimientos"
                ],
                "summary": "Actualizar un establecimiento",
                "description": "Actualiza un establecimiento existente. Para enviar archivos, se recomienda usar override con _method=PUT.",
                "operationId": "0f7dbb26850bbb36c87cb68b8c6b23b3",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del establecimiento a actualizar",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "_method": {
                                        "description": "PUT",
                                        "type": "string"
                                    },
                                    "nombre": {
                                        "description": "Establecimiento Actualizado",
                                        "type": "string"
                                    },
                                    "nit": {
                                        "description": "987654321",
                                        "type": "string"
                                    },
                                    "direccion": {
                                        "description": "Nueva dirección",
                                        "type": "string"
                                    },
                                    "telefono": {
                                        "description": "555-5678",
                                        "type": "string"
                                    },
                                    "logo": {
                                        "description": "Archivo para actualizar el logo",
                                        "type": "Base64",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Establecimiento actualizado correctamente."
                    },
                    "default": {
                        "description": "Ha ocurrido un error."
                    }
                }
            },
            "delete": {
                "tags": [
                    "Establecimientos"
                ],
                "summary": "Eliminar un establecimiento (borrado lógico)",
                "description": "Cambia el estado del establecimiento a 'I' (inactivo)",
                "operationId": "ab3cf94595621e1bdc6fb5fd20064086",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del establecimiento a eliminar",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Establecimiento eliminado correctamente."
                    },
                    "default": {
                        "description": "Ha ocurrido un error."
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Autenticación",
            "description": "Endpoints para autenticación con JWT"
        },
        {
            "name": "Usuarios",
            "description": "Usuarios"
        },
        {
            "name": "Establecimientos",
            "description": "Establecimientos"
        }
    ]
}